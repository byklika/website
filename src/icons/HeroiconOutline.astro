---
import { cn } from '~/lib/helpers';
import { HEROICON_OUTLINE_PATHS, type HeroiconOutlineName } from '~/icons/heroiconOutlinePaths';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'svg'> {
  name: HeroiconOutlineName;
  /** Method cards on dark bg; about cards inherit moss tint from parent. */
  variant?: 'methodology' | 'about';
}

const { name, variant = 'about', class: className, ...attrs } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  {...attrs}
  class={cn(
    variant === 'methodology' && 'h-8 w-8 text-klika-cream',
    variant === 'about' && 'h-7 w-7',
    className
  )}
>
  <path stroke-linecap="round" stroke-linejoin="round" d={HEROICON_OUTLINE_PATHS[name]} />
</svg>
