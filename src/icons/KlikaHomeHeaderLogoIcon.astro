---
import { cn } from '~/lib/helpers';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props as Props;
---

<svg
  width="52"
  height="32"
  viewBox="0 0 104 60"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  {...attrs}
  class={cn('shrink-0', className)}
>
  <line x1="8" y1="54" x2="96" y2="54" stroke="currentColor" class="text-klika-moss2" stroke-width="2"></line>
  <circle cx="8" cy="54" r="4" stroke="currentColor" class="text-klika-moss2" stroke-width="2" fill="none"></circle>
  <circle cx="96" cy="54" r="4" stroke="currentColor" class="text-klika-moss2" stroke-width="2" fill="none"></circle>
  <path
    d="M8 54 A44 44 0 0 1 96 54"
    stroke="currentColor"
    class="text-klika-moss2"
    stroke-width="2.2"
    fill="none"
    stroke-linecap="round"></path>
  <path
    d="M22 54 A30 30 0 0 1 82 54"
    stroke="currentColor"
    class="text-klika-moss2"
    stroke-width="2.2"
    fill="none"
    stroke-linecap="round"></path>
  <path
    d="M36 54 A16 16 0 0 1 68 54"
    stroke="currentColor"
    class="text-klika-cream"
    stroke-width="3"
    fill="none"
    stroke-linecap="round"></path>
  <circle cx="52" cy="38" r="5.5" fill="currentColor" class="text-klika-coral"></circle>
</svg>
