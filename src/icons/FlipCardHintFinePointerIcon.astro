---
import { cn } from '~/lib/helpers';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props as Props;
---

<svg
  width="13"
  height="13"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  {...attrs}
  class={cn(className)}
>
  <path d="M5.5 3.2 5.5 17.5 9.8 12.2 12.4 20.1 14.8 18.9 12.1 10.8 19.5 10.8 5.5 3.2z"></path>
</svg>
