---
import { cn } from '~/lib/helpers';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props as Props;
---

<svg
  width="28"
  height="28"
  viewBox="0 0 28 28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...attrs}
  class={cn(className)}
>
  <circle cx="14" cy="14" r="9"></circle>
  <path d="M14 8 L14 14 L18 16"></path>
</svg>
