---
import { cn } from '~/lib/helpers';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props as Props;
---

<svg
  width="13"
  height="13"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  aria-hidden="true"
  {...attrs}
  class={cn(className)}
>
  <circle cx="12" cy="12" r="7.25"></circle>
  <circle cx="12" cy="12" r="4"></circle>
  <circle cx="12" cy="12" r="1.25" fill="currentColor" stroke="none"></circle>
</svg>
