---
import { cn } from '~/lib/helpers';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props as Props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke-width="1.5"
  stroke-linecap="round"
  preserveAspectRatio="xMidYMid meet"
  {...attrs}
  class={cn(
    'block stroke-current text-white',
    'min-h-0 min-w-0 max-w-full',
    'max-[900px]:h-auto max-[900px]:w-auto max-[900px]:max-h-[50%]',
    'min-[901px]:h-2.5 min-[901px]:w-2.5 min-[901px]:shrink-0',
    className
  )}
>
  <circle cx="12" cy="12" r="10"></circle>
  <path d="M2 12 Q7 9 12 12 Q17 15 22 12"></path>
  <path d="M12 2 Q9 7 12 12 Q15 17 12 22"></path>
</svg>
