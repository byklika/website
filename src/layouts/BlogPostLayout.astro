---
import type { CollectionEntry } from 'astro:content';
import '~/styles/blog-article.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogArticleBanner from '~/components/blog/BlogArticleBanner.astro';
import BlogArticleAuthor from '~/components/blog/BlogArticleAuthor.astro';
import BlogArticleCta from '~/components/blog/BlogArticleCta.astro';
import BlogArticleLead from '~/components/blog/BlogArticleLead.astro';
import BlogArticleHeader from '~/components/blog/BlogArticleHeader.astro';
import BlogRelatedPosts from '~/components/blog/BlogRelatedPosts.astro';
import { formatArticleSeoTitle } from '~/data/seoOnPageContract';
import { blogPostHref } from '~/lib/blog-card';
import { blogImageOgUrl } from '~/lib/blog-image';
import type { HeroImagePositionInput } from '~/lib/blog-hero-position';
import {
  buildBlogBreadcrumbSchema,
  buildBlogPostingSchema,
  resolveSiteOrigin
} from '~/lib/seo/schema';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
  category: string;
  tags: string[];
  readingTimeMinutes: number;
  heroImage?: string;
  heroImageSlug?: string;
  heroImagePosition?: HeroImagePositionInput;
  authorName: string;
  authorEmail: string;
  lead?: string;
  ctaDescription?: string;
  ctaButtonLabel?: string;
  /** Resolved related posts — rendered in Iteration 4. */
  relatedPosts: CollectionEntry<'blog'>[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  slug,
  category,
  tags,
  readingTimeMinutes,
  heroImage,
  heroImageSlug,
  heroImagePosition,
  authorName,
  authorEmail,
  lead,
  ctaDescription,
  ctaButtonLabel,
  relatedPosts
} = Astro.props;

const socialImage = heroImageSlug ? blogImageOgUrl(heroImageSlug) : heroImage;
const siteOrigin = resolveSiteOrigin(Astro.site, Astro.url.origin);
const articlePath = blogPostHref(slug);
const articleDescription = description ?? `Leé “${title}” en el blog de Klika.`;
const articleImagePath = heroImageSlug
  ? blogImageOgUrl(heroImageSlug)
  : heroImage?.startsWith('/')
    ? heroImage
    : undefined;

const articleJsonLd = [
  buildBlogPostingSchema({
    origin: siteOrigin,
    articlePath,
    headline: title,
    description: articleDescription,
    datePublished: pubDate.toISOString(),
    dateModified: updatedDate?.toISOString(),
    authorName,
    imagePath: articleImagePath
  }),
  buildBlogBreadcrumbSchema({
    origin: siteOrigin,
    articlePath,
    category,
    title
  })
];
---

<BaseLayout
  fullWidthMain
  title={formatArticleSeoTitle(title)}
  description={articleDescription}
  image={socialImage}
  ogType="article"
  articlePublishedTime={pubDate.toISOString()}
  articleModifiedTime={updatedDate?.toISOString()}
  jsonLd={articleJsonLd}
>
  <div class="blog-article-page pt-[var(--site-header-height)]">
    <BlogArticleBanner {title} imageSlug={heroImageSlug} {heroImagePosition} />

    <article class="blog-article-content">
      <div class="blog-article-content__inner section-gutter-x mx-auto max-w-[720px]">
        <BlogArticleHeader {title} {category} {tags} {pubDate} {readingTimeMinutes} />

        {lead ? <BlogArticleLead text={lead} /> : null}

        <div class="article-body">
          <slot />
        </div>

        <hr class="blog-article-divider" aria-hidden="true" />

        <BlogArticleAuthor {authorName} {authorEmail} />

        <BlogArticleCta description={ctaDescription} buttonLabel={ctaButtonLabel} />

        <BlogRelatedPosts currentSlug={slug} {relatedPosts} />
      </div>
    </article>
  </div>
</BaseLayout>
