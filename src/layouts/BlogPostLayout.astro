---
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, pubDate, updatedDate } = Astro.props;

const dateFmt: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
};
const published = pubDate.toLocaleDateString('es', dateFmt);
const updated =
  updatedDate && updatedDate.getTime() !== pubDate.getTime()
    ? updatedDate.toLocaleDateString('es', dateFmt)
    : null;
---

<BaseLayout
  title={`${title} — Klika`}
  description={description ?? `Leé “${title}” en el blog de Klika.`}
  ogType="article"
  articlePublishedTime={pubDate.toISOString()}
  articleModifiedTime={updatedDate?.toISOString()}
>
  <article class="prose prose-neutral max-w-none text-klika-dark">
    <header class="not-prose mb-8">
      <p class="mb-2 text-sm text-klika-dark/60">
        <time datetime={pubDate.toISOString()}>{published}</time>
        {
          updated && (
            <>
              {' '}
              · Actualizado <time datetime={updatedDate!.toISOString()}>{updated}</time>
            </>
          )
        }
      </p>
      <h1 class="text-4xl font-bold text-klika-dark">{title}</h1>
      {description && <p class="mt-2 text-lg text-klika-dark/80">{description}</p>}
    </header>
    <div class="prose-headings:scroll-mt-28">
      <slot />
    </div>
  </article>
</BaseLayout>
