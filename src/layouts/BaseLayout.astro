---
import '~/styles/global.css';
import HeadEssentials from '~/components/layout/HeadEssentials.astro';
import SiteBodyChrome from '~/components/layout/SiteBodyChrome.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import {
  SEO_DEFAULT_OG_IMAGE,
  SEO_HTML_LANG,
  SEO_OG_LOCALE,
  SEO_SITE_DEFAULT_DESCRIPTION
} from '~/data/seoOnPageContract';
import { buildOrganizationSchema, buildWebSiteSchema, resolveSiteOrigin } from '~/lib/seo/schema';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** Homepage and other full-bleed pages: no inner max-width wrapper (still clears fixed header). */
  fullWidthMain?: boolean;
  /** Path or absolute URL for og:image / twitter:image */
  image?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes merged after site-wide Organization + WebSite. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE_NAME = 'klika e‑learning studio';

const {
  title = SITE_NAME,
  description = SEO_SITE_DEFAULT_DESCRIPTION,
  lang = SEO_HTML_LANG,
  fullWidthMain = false,
  image,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd
} = Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const siteOrigin = resolveSiteOrigin(Astro.site, canonicalURL.origin);

const siteJsonLd = [buildOrganizationSchema(siteOrigin), buildWebSiteSchema(siteOrigin)];
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [...siteJsonLd, ...extraJsonLd];

function toAbsoluteImage(src: string): string {
  if (src.startsWith('http://') || src.startsWith('https://')) return src;
  const path = src.startsWith('/') ? src : `/${src}`;
  return new URL(path, canonicalURL.origin).href;
}

const ogImage = image ? toAbsoluteImage(image) : toAbsoluteImage(SEO_DEFAULT_OG_IMAGE);
const ogLocale = lang === SEO_HTML_LANG ? SEO_OG_LOCALE : 'en_US';
---

<!doctype html>
<html {lang} data-theme="light">
  <head>
    <HeadEssentials showGenerator={false} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    {
      ogType === 'article' && articlePublishedTime && (
        <meta property="article:published_time" content={articlePublishedTime} />
      )
    }
    {
      ogType === 'article' && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <JsonLd data={structuredData} />
  </head>
  <body class="bg-klika-cream text-klika-dark flex min-h-screen flex-col">
    <SiteBodyChrome>
      {
        fullWidthMain ? (
          <main class="w-full flex-1">
            <slot />
          </main>
        ) : (
          <main class="w-full flex-1">
            <div class="mx-auto w-full max-w-5xl px-4 pt-24 pb-12">
              <slot />
            </div>
          </main>
        )
      }
    </SiteBodyChrome>
    <script is:inline>
      const els = Array.from(document.querySelectorAll('.reveal'));
      if (els.length) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08 }
        );
        for (const el of els) obs.observe(el);
      }
    </script>
  </body>
</html>
