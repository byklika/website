---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	/** Path or absolute URL for og:image / twitter:image */
	image?: string;
	ogType?: 'website' | 'article';
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	noindex?: boolean;
}

const SITE_NAME = 'Klika';
const DEFAULT_DESCRIPTION =
	'Klika helps you ship modern web experiences — static-first, fast, and focused on conversion.';

const {
	title = SITE_NAME,
	description = DEFAULT_DESCRIPTION,
	lang = 'en',
	image,
	ogType = 'website',
	articlePublishedTime,
	articleModifiedTime,
	noindex = false
} = Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);

function toAbsoluteImage(src: string): string {
	if (src.startsWith('http://') || src.startsWith('https://')) return src;
	const path = src.startsWith('/') ? src : `/${src}`;
	return new URL(path, canonicalURL.origin).href;
}

const ogImage = image ? toAbsoluteImage(image) : toAbsoluteImage('/favicon.svg');
---

<!doctype html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL.href} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />
		{
			ogType === 'article' && articlePublishedTime && (
				<meta property="article:published_time" content={articlePublishedTime} />
			)
		}
		{
			ogType === 'article' && articleModifiedTime && (
				<meta property="article:modified_time" content={articleModifiedTime} />
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body class="bg-base-200 text-base-content min-h-screen flex flex-col">
		<Header />
		<main class="flex-1 w-full max-w-5xl mx-auto px-4 py-8">
			<slot />
		</main>
		<Footer />
	</body>
</html>
