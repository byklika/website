---
import '~/styles/global.css';
import HeadEssentials from '~/components/layout/HeadEssentials.astro';
import SiteBodyChrome from '~/components/layout/SiteBodyChrome.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
}

const SITE_NAME = 'Klika';
const DEFAULT_DESCRIPTION = 'E‑Learning Studio — experiencias educativas que dejan huella.';

const { title = SITE_NAME, description = DEFAULT_DESCRIPTION, lang = 'es', noindex = false } =
  Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
---

<!doctype html>
<html {lang} data-theme="light">
  <head>
    <HeadEssentials showGenerator={false} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class="bg-klika-cream text-klika-dark min-h-screen">
    <SiteBodyChrome>
      <main class="w-full">
        <slot />
      </main>
    </SiteBodyChrome>
    <script is:inline>
      const els = Array.from(document.querySelectorAll('.reveal'));
      if (els.length) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08 }
        );
        for (const el of els) obs.observe(el);
      }
    </script>
  </body>
</html>

