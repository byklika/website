---
interface Props {
  title: string;
  description?: string;
  /** Used when `openContactSheet` is false */
  href?: string;
  label: string;
  /** Opens the global contact sheet (same as Hablemos) instead of navigating */
  openContactSheet?: boolean;
}

const { title, description, href, label, openContactSheet = false } = Astro.props;
---

<section class="cta-component card bg-base-100 border-base-300 border shadow-md">
  <div class="card-body items-center gap-4 text-center">
    <h2 class="card-title text-2xl">{title}</h2>
    {description && <p class="text-base-content/80 max-w-lg">{description}</p>}
    <div class="card-actions">
      {
        openContactSheet ? (
          <button
            type="button"
            class="btn btn-primary"
            aria-haspopup="dialog"
            aria-controls="contact-sheet"
            data-sheet-open="contact-sheet"
          >
            {label}
          </button>
        ) : (
          <a href={href} class="btn btn-primary">
            {label}
          </a>
        )
      }
    </div>
  </div>
</section>
