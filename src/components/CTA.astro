---
interface Props {
	title: string;
	description?: string;
	href: string;
	label: string;
}

const { title, description, href, label } = Astro.props;
---

<section class="card bg-base-100 shadow-md border border-base-300">
	<div class="card-body items-center text-center gap-4">
		<h2 class="card-title text-2xl">{title}</h2>
		{description && <p class="text-base-content/80 max-w-lg">{description}</p>}
		<div class="card-actions">
			<a href={href} class="btn btn-primary">{label}</a>
		</div>
	</div>
</section>
