---
/**
 * Loads only when the matching PUBLIC_* env var is set (e.g. in Vercel project settings).
 * See `.env.example` for variable names.
 */
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim();
const growthbookClientKey = import.meta.env.PUBLIC_GROWTHBOOK_CLIENT_KEY?.trim();
---

{
	gaMeasurementId && (
		<>
			<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
			<script is:inline define:vars={{ gaMeasurementId }}>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag('js', new Date());
				gtag('config', gaMeasurementId);
			</script>
		</>
	)
}

{
	clarityProjectId && (
		<script is:inline define:vars={{ clarityProjectId }}>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = 'https://www.clarity.ms/tag/' + i;
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, 'clarity', 'script', clarityProjectId);
		</script>
	)
}

{
	growthbookClientKey && (
		<script>
			import { GrowthBook } from '@growthbook/growthbook';

			const clientKey = import.meta.env.PUBLIC_GROWTHBOOK_CLIENT_KEY;

			const gb = new GrowthBook({
				apiHost: 'https://cdn.growthbook.io',
				clientKey,
				enableDevMode: import.meta.env.DEV,
				trackingCallback: (experiment, result) => {
					if (typeof window.gtag === 'function') {
						window.gtag('event', 'experiment_viewed', {
							experiment_id: experiment.key,
							variation_id: result.key
						});
					}
				}
			});

			gb.init()
				.then(() => {
					window.growthbook = gb;
				})
				.catch((err) => {
					if (import.meta.env.DEV) {
						console.error('[GrowthBook]', err);
					}
				});
		</script>
	)
}
