---
/**
 * Loads only when the matching PUBLIC_* env var is set (e.g. in Vercel project settings).
 * See `.env.example` for variable names.
 */
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim();
const growthbookClientKey = import.meta.env.PUBLIC_GROWTHBOOK_CLIENT_KEY?.trim();

const gaInline = gaMeasurementId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(Array.prototype.slice.call(arguments));}
gtag('js', new Date());
gtag('config', '${gaMeasurementId}');`
  : null;

const clarityInline = clarityProjectId
  ? `(function (c, l, a, r, i, t, y) {
	c[a] =
		c[a] ||
		function () {
			(c[a].q = c[a].q || []).push(arguments);
		};
	t = l.createElement(r);
	t.async = 1;
	t.src = 'https://www.clarity.ms/tag/' + i;
	y = l.getElementsByTagName(r)[0];
	y.parentNode.insertBefore(t, y);
})(window, document, 'clarity', 'script', '${clarityProjectId}');`
  : null;

const growthbookInline = growthbookClientKey
  ? `const { GrowthBook } = window.growthbook || {};
if (GrowthBook) {
	const gb = new GrowthBook({
		apiHost: 'https://cdn.growthbook.io',
		clientKey: '${growthbookClientKey}',
		enableDevMode: ${import.meta.env.DEV ? 'true' : 'false'},
		trackingCallback: (experiment, result) => {
			if (typeof window.gtag === 'function') {
				window.gtag('event', 'experiment_viewed', {
					experiment_id: experiment.key,
					variation_id: result.key
				});
			}
		}
	});

	gb.init()
		.then(() => {
			window.growthbook = gb;
		})
		.catch((err) => {
			if (${import.meta.env.DEV ? 'true' : 'false'}) console.error('[GrowthBook]', err);
		});
}`
  : null;
---

{
  gaMeasurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
      <script is:inline set:html={gaInline!} />
    </>
  )
}

{clarityProjectId && <script is:inline set:html={clarityInline!} />}

{
  growthbookClientKey && (
    <>
      <script src="https://cdn.jsdelivr.net/npm/@growthbook/growthbook/dist/bundles/index.js" />
      <script is:inline set:html={growthbookInline!} />
    </>
  )
}
