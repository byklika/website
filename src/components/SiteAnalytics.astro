---
/**
 * Loads only when the matching PUBLIC_* env var is set (e.g. in Vercel project settings).
 * See `.env.example` for variable names.
 *
 * **GA4 / PUBLIC_ vars:** Astro inlines `import.meta.env.PUBLIC_*` at **build** time. Adding
 * `PUBLIC_GA_MEASUREMENT_ID` only in `.env.local` affects `astro dev` / local `astro build`;
 * production HTML will **omit** the GA snippet unless the same variable is set for the
 * **build** on the host (e.g. Vercel → Settings → Environment Variables → Production) and you
 * **redeploy** after saving.
 *
 * Production stack: GA4 + Clarity + GrowthBook (optional). GA and Clarity boot are deferred
 * (idle / first interaction); GrowthBook `init()` runs on idle. See `docs/analytics.md`.
 */
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim();

/** Third argument to `gtag('config', …)` — disable auto page_view so we send one explicit `page_view` once gtag loads. */
const gaConfigOpts: Record<string, boolean> = { send_page_view: false };
if (import.meta.env.DEV) {
  gaConfigOpts.debug_mode = true;
}
---

<div
  class="site-analytics-component"
  data-public-ga={gaMeasurementId ? 'on' : 'off'}
  data-public-clarity={clarityProjectId ? 'on' : 'off'}
  data-ga-measurement-id={gaMeasurementId ?? ''}
  data-clarity-project-id={clarityProjectId ?? ''}
  data-ga-config={JSON.stringify(gaConfigOpts)}
>
  <script>
    import { bootSiteAnalytics } from '~/lib/analytics/bootSiteAnalytics';
    import { bootGrowthBookOnIdle } from '~/lib/experiments/bootGrowthBook';

    bootSiteAnalytics();
    bootGrowthBookOnIdle();
  </script>
</div>
