---
import { siteNavItems } from '~/data/siteNav';

const year = new Date().getFullYear();
---

<footer class="footer-component section-gutter-x border-t border-white/10 bg-klika-dark py-8 text-klika-white">
  <div class="layout-container flex flex-col items-center justify-between gap-6 min-[901px]:flex-row">
    <div class="text-center min-[901px]:text-left">
      <p class="font-mitr text-[1.1rem] font-normal lowercase tracking-[-0.3px]">klika</p>
      <p class="mt-1 text-[0.75rem] text-white/35">e‑learning studio</p>
    </div>

    <nav class="flex flex-wrap justify-center gap-[1.8rem]" aria-label="Footer">
      {
        siteNavItems.map((item) =>
          item.kind === 'link' ? (
            <a
              href={item.href}
              class="text-[0.8rem] text-white/40 no-underline transition hover:text-klika-coral"
            >
              {item.label}
            </a>
          ) : (
            <button
              type="button"
              class="cursor-pointer border-0 bg-transparent p-0 text-[0.8rem] text-white/40 no-underline transition hover:text-klika-coral"
              aria-haspopup="dialog"
              aria-controls="contact-sheet"
              data-sheet-open="contact-sheet"
            >
              {item.label}
            </button>
          )
        )
      }
    </nav>

    <button
      type="button"
      class="rounded-pill bg-klika-coral px-[1.3rem] py-[0.55rem] text-[0.8rem] font-semibold text-klika-white hover:bg-klika-coralHover"
      aria-haspopup="dialog"
      aria-controls="contact-sheet"
      data-sheet-open="contact-sheet"
    >
      Hablemos
    </button>
  </div>
  <p class="layout-container mt-4 text-center text-[0.75rem] text-white/35">
    &copy; {year}{' '}
    <span class="font-mitr font-normal lowercase tracking-[-0.3px]">klika</span>. All rights reserved.
  </p>
</footer>
