---
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SiteAnalytics from '~/components/SiteAnalytics.astro';
import Sheet from '~/components/Sheet.astro';
import ContactForm from '~/components/ContactForm.astro';
import { contactSheetCopy } from '~/data/contactSheetContract';
---

<Header />
<slot />
<Footer />

<Sheet id="contact-sheet" variant="contact" side="right">
  <span slot="title">{contactSheetCopy.title}</span>

  <p class="text-klika-muted mb-[2.2rem] text-[0.92rem] leading-[1.6]">
    {contactSheetCopy.intro}
  </p>

  <ContactForm tone="light" idBase="contact-sheet" />
</Sheet>

<SiteAnalytics />

<script>
  import '~/scripts/projectStage.ts';
  import '~/scripts/contactForms.ts';
</script>
