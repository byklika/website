---
/**
 * Shared document head: icons, optional generator meta, and third-party resource hints.
 */
interface Props {
  showGenerator?: boolean;
}

const { showGenerator = true } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
{showGenerator && <meta name="generator" content={Astro.generator} />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-light.svg"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-dark.svg"
  media="(prefers-color-scheme: dark)"
/>
<link rel="apple-touch-icon" href="/favicon-light.svg" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Mitr:wght@400&display=swap"
  rel="stylesheet"
/>

<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://www.clarity.ms" />
<link rel="dns-prefetch" href="https://cdn.growthbook.io" />
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="preconnect" href="https://cdn.growthbook.io" crossorigin />
