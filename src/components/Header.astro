---
import KlikaHomeHeaderLogoIcon from '~/icons/KlikaHomeHeaderLogoIcon.astro';
import { headerNavItems } from '~/data/siteNav';
import { NAV_NOSOTRAS_FLAG_KEY } from '~/lib/experiments/constants';
import { getNavNosotrasLabelFallback } from '~/lib/experiments/nav-nosotras-label';

const pathname = Astro.url?.pathname ?? '/';
const navLabelFallback = getNavNosotrasLabelFallback();
const growthbookEnabled = Boolean(import.meta.env.PUBLIC_GROWTHBOOK_CLIENT_KEY?.trim());

const headerNavExperimentConfig = {
  flagKey: NAV_NOSOTRAS_FLAG_KEY,
  fallback: navLabelFallback,
  growthbookEnabled
};

function isLinkActive(href: string) {
  if (href === '/#inicio') return pathname === '/';
  if (href.startsWith('/#')) return false;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  id="homeHeader"
  class="header-component z-header bg-klika-dark fixed inset-x-0 top-0 shadow-[0_2px_16px_rgba(0,0,0,0.15)]"
>
  <div class="section-gutter-x py-4">
    <div class="layout-container flex items-center justify-between gap-4">
      <a href="/#inicio" class="flex items-center gap-3 no-underline">
        <KlikaHomeHeaderLogoIcon />
        <span
          class="font-mitr text-klika-white text-[1.1rem] font-normal tracking-[-0.3px] lowercase"
        >
          klika
        </span>
      </a>

      <nav
        class="hidden cursor-pointer items-center gap-[1.8rem] min-[901px]:flex"
        aria-label="Primary"
      >
        {
          headerNavItems.map((item) =>
            item.kind === 'link' ? (
              <a
                href={item.href}
                class:list={[
                  'header-nav-link',
                  'hover:text-klika-white text-[0.88rem] font-medium text-white/85 no-underline'
                ]}
                data-nav-section={item.href.startsWith('/#') ? item.href.slice(2) : undefined}
                aria-current={
                  item.href.startsWith('/#')
                    ? undefined
                    : isLinkActive(item.href)
                      ? 'page'
                      : undefined
                }
                data-nav-nosotras-label={item.href === '/#nosotras' ? 'true' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <button
                type="button"
                class="hover:text-klika-white text-[0.88rem] font-medium text-white/85 no-underline"
                aria-haspopup="dialog"
                aria-controls="contact-sheet"
                data-sheet-open="contact-sheet"
              >
                {item.label}
              </button>
            )
          )
        }
        <button
          type="button"
          class="rounded-pill bg-klika-coral text-klika-white hover:bg-klika-coralHover px-[1.4rem] py-[0.55rem] text-[0.85rem] font-semibold"
          aria-haspopup="dialog"
          aria-controls="contact-sheet"
          data-sheet-open="contact-sheet"
        >
          Hablemos
        </button>
      </nav>

      <details class="relative min-[901px]:hidden">
        <summary
          class="rounded-pill text-klika-white cursor-pointer list-none border border-white/20 px-4 py-2 text-sm"
          aria-label="Open menu"
        >
          Menú
        </summary>
        <div
          class="bg-klika-dark absolute right-0 mt-2 w-56 rounded-xl p-2 shadow-[0_16px_48px_rgba(0,0,0,0.35)]"
        >
          <div class="flex flex-col">
            {
              headerNavItems.map((item) =>
                item.kind === 'link' ? (
                  <a
                    href={item.href}
                    class:list={[
                      'header-nav-link header-nav-link--menu',
                      'hover:text-klika-white rounded-lg px-3 py-2 text-sm text-white/85 no-underline hover:bg-white/10'
                    ]}
                    data-nav-section={item.href.startsWith('/#') ? item.href.slice(2) : undefined}
                    aria-current={
                      item.href.startsWith('/#')
                        ? undefined
                        : isLinkActive(item.href)
                          ? 'page'
                          : undefined
                    }
                    data-nav-nosotras-label={item.href === '/#nosotras' ? 'true' : undefined}
                  >
                    {item.label}
                  </a>
                ) : (
                  <button
                    type="button"
                    class="hover:text-klika-white rounded-lg px-3 py-2 text-left text-sm text-white/85 hover:bg-white/10"
                    aria-haspopup="dialog"
                    aria-controls="contact-sheet"
                    data-sheet-open="contact-sheet"
                  >
                    {item.label}
                  </button>
                )
              )
            }
            <button
              type="button"
              class="bg-klika-coral text-klika-white hover:bg-klika-coralHover mt-1 rounded-lg px-3 py-2 text-left text-sm font-semibold"
              aria-haspopup="dialog"
              aria-controls="contact-sheet"
              data-sheet-open="contact-sheet"
            >
              Hablemos
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script
  type="application/json"
  is:inline
  id="header-nav-experiment"
  set:html={JSON.stringify(headerNavExperimentConfig)}
/>

<script>
  import { scheduleDomIdle } from '~/lib/scheduleDomIdle';
  import { initHeaderNav } from '~/scripts/header-nav';

  scheduleDomIdle(initHeaderNav);
</script>
