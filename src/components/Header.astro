---
import KlikaHomeHeaderLogoIcon from '~/icons/KlikaHomeHeaderLogoIcon.astro';
import { headerNavItems } from '~/data/siteNav';
import { NAV_NOSOTRAS_FLAG_KEY } from '~/lib/experiments/constants';
import { getNavNosotrasLabelFallback } from '~/lib/experiments/nav-nosotras-label';

const pathname = Astro.url?.pathname ?? '/';
const navLabelFallback = getNavNosotrasLabelFallback();
const growthbookEnabled = Boolean(import.meta.env.PUBLIC_GROWTHBOOK_CLIENT_KEY?.trim());

const headerNavExperimentConfig = {
  flagKey: NAV_NOSOTRAS_FLAG_KEY,
  fallback: navLabelFallback,
  growthbookEnabled
};

function isLinkActive(href: string) {
  if (href === '/#inicio') return pathname === '/';
  if (href.startsWith('/#')) return false;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  id="homeHeader"
  class="header-component fixed inset-x-0 top-0 z-50 bg-klika-dark shadow-[0_2px_16px_rgba(0,0,0,0.15)]"
>
  <div class="section-gutter-x py-4">
    <div class="layout-container flex items-center justify-between gap-4">
      <a href="/#inicio" class="flex items-center gap-3 no-underline">
        <KlikaHomeHeaderLogoIcon />
        <span class="font-mitr text-[1.1rem] font-normal lowercase tracking-[-0.3px] text-klika-white">
          klika
        </span>
      </a>

      <nav class="hidden items-center gap-[1.8rem] min-[901px]:flex" aria-label="Primary">
        {
          headerNavItems.map((item) =>
            item.kind === 'link' ? (
              <a
                href={item.href}
                class={`text-[0.88rem] font-medium no-underline hover:text-klika-white ${
                  isLinkActive(item.href) ? 'text-klika-white font-semibold' : 'text-white/85'
                }`}
                aria-current={isLinkActive(item.href) ? 'page' : undefined}
                data-nav-nosotras-label={item.href === '/#nosotras' ? 'true' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <button
                type="button"
                class="text-[0.88rem] font-medium text-white/85 no-underline hover:text-klika-white"
                aria-haspopup="dialog"
                aria-controls="contact-sheet"
                data-sheet-open="contact-sheet"
              >
                {item.label}
              </button>
            )
          )
        }
        <button
          type="button"
          class="rounded-pill bg-klika-coral px-[1.4rem] py-[0.55rem] text-[0.85rem] font-semibold text-klika-white hover:bg-klika-coralHover"
          aria-haspopup="dialog"
          aria-controls="contact-sheet"
          data-sheet-open="contact-sheet"
        >
          Hablemos
        </button>
      </nav>

      <details class="relative min-[901px]:hidden">
        <summary
          class="cursor-pointer list-none rounded-pill border border-white/20 px-4 py-2 text-sm text-klika-white"
          aria-label="Open menu"
        >
          Menú
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-xl bg-klika-dark p-2 shadow-[0_16px_48px_rgba(0,0,0,0.35)]">
          <div class="flex flex-col">
            {
              headerNavItems.map((item) =>
                item.kind === 'link' ? (
                  <a
                    href={item.href}
                    class={`rounded-lg px-3 py-2 text-sm no-underline hover:bg-white/10 hover:text-klika-white ${
                      isLinkActive(item.href) ? 'bg-white/10 text-klika-white font-semibold' : 'text-white/85'
                    }`}
                    aria-current={isLinkActive(item.href) ? 'page' : undefined}
                    data-nav-nosotras-label={item.href === '/#nosotras' ? 'true' : undefined}
                  >
                    {item.label}
                  </a>
                ) : (
                  <button
                    type="button"
                    class="rounded-lg px-3 py-2 text-left text-sm text-white/85 hover:bg-white/10 hover:text-klika-white"
                    aria-haspopup="dialog"
                    aria-controls="contact-sheet"
                    data-sheet-open="contact-sheet"
                  >
                    {item.label}
                  </button>
                )
              )
            }
            <button
              type="button"
              class="mt-1 rounded-lg bg-klika-coral px-3 py-2 text-left text-sm font-semibold text-klika-white hover:bg-klika-coralHover"
              aria-haspopup="dialog"
              aria-controls="contact-sheet"
              data-sheet-open="contact-sheet"
            >
              Hablemos
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script type="application/json" is:inline id="header-nav-experiment" set:html={JSON.stringify(headerNavExperimentConfig)}
></script>

<script>
  import { initHeaderNav } from '~/scripts/header-nav';
  initHeaderNav();
</script>
