---
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  fromPathLabel: string;
  toPath: string;
}

const { fromPathLabel, toPath } = Astro.props;
---

<BaseLayout
  title={`Redirigiendo ${fromPathLabel} — Klika`}
  description={`La ruta ${fromPathLabel} ahora vive en ${toPath}.`}
  noindex
>
  <meta http-equiv="refresh" content={`0;url=${toPath}`} />
  <section class="prose max-w-none">
    <h1>Redirección</h1>
    <p>
      Esta URL cambió a <a href={toPath}>{toPath}</a>. Si no te redirigimos automáticamente, hacé clic
      en el enlace.
    </p>
  </section>
  <script is:inline define:vars={{ toPath }}>
    window.location.replace(toPath);
  </script>
</BaseLayout>
