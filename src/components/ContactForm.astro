---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim();
const configured = Boolean(accessKey);
---

<div class="w-full">
  {
    !configured && (
      <div role="alert" class="mb-6 rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white/80">
        <span>
          El formulario no está configurado. Definí{' '}
          <code class="rounded bg-white/10 px-1 text-xs text-white">PUBLIC_WEB3FORMS_ACCESS_KEY</code> en{' '}
          <code class="rounded bg-white/10 px-1 text-xs text-white">.env</code> (ver{' '}
          <code class="rounded bg-white/10 px-1 text-xs text-white">.env.example</code>) y volvé a desplegar.
        </span>
      </div>
    )
  }

  <form id="contact-form" class="flex flex-col gap-5" novalidate>
    <input type="hidden" name="access_key" value={accessKey ?? ''} />

    {/* Honeypot — leave empty; Web3Forms rejects spam when filled */}
    <label class="hidden" aria-hidden="true">
      <span>Company</span>
      <input type="text" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-[0.78rem] font-semibold tracking-[0.05em] text-white/50">NOMBRE</span>
      <input
        type="text"
        name="name"
        required
        minlength="2"
        maxlength="120"
        class="w-full rounded-[0.8rem] border border-white/[0.14] bg-white/[0.06] px-[1.1rem] py-[0.85rem] text-[0.9rem] text-white placeholder:text-white/25 outline-none transition focus:border-klika-coral focus:bg-white/[0.09]"
        autocomplete="name"
        disabled={!configured}
        placeholder="tu nombre"
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-[0.78rem] font-semibold tracking-[0.05em] text-white/50">ORGANIZACIÓN</span>
      <input
        type="text"
        name="organization"
        maxlength="200"
        class="w-full rounded-[0.8rem] border border-white/[0.14] bg-white/[0.06] px-[1.1rem] py-[0.85rem] text-[0.9rem] text-white placeholder:text-white/25 outline-none transition focus:border-klika-coral focus:bg-white/[0.09]"
        autocomplete="organization"
        disabled={!configured}
        placeholder="Nombre de empresa / institución"
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-[0.78rem] font-semibold tracking-[0.05em] text-white/50">EMAIL</span>
      <input
        type="email"
        name="email"
        required
        maxlength="254"
        class="w-full rounded-[0.8rem] border border-white/[0.14] bg-white/[0.06] px-[1.1rem] py-[0.85rem] text-[0.9rem] text-white placeholder:text-white/25 outline-none transition focus:border-klika-coral focus:bg-white/[0.09]"
        autocomplete="email"
        disabled={!configured}
        placeholder="tu@correo.com"
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-[0.78rem] font-semibold tracking-[0.05em] text-white/50">CONTANOS MÁS</span>
      <textarea
        name="message"
        required
        minlength="10"
        maxlength="5000"
        rows={6}
        class="min-h-[120px] w-full resize-y rounded-[0.8rem] border border-white/[0.14] bg-white/[0.06] px-[1.1rem] py-[0.85rem] text-[0.9rem] text-white placeholder:text-white/25 outline-none transition focus:border-klika-coral focus:bg-white/[0.09]"
        disabled={!configured}
        placeholder="¿En qué etapa de tu proyecto estás? ¿Qué necesitás?"
      ></textarea>
    </label>

    <div class="flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="inline-flex items-center gap-2 self-start rounded-pill bg-klika-coral px-[1.8rem] py-[0.75rem] text-[0.9rem] font-semibold text-klika-white transition hover:bg-klika-coralHover disabled:cursor-not-allowed disabled:opacity-60"
        disabled={!configured}
        id="contact-submit"
      >
        Enviar →
      </button>
      <span id="contact-form-status" class="text-sm text-white/80" role="status" aria-live="polite"></span>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-form-status');
  const submitBtn = document.getElementById('contact-submit');

  function setStatus(kind, message) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.className = 'text-sm';
    if (kind === 'ok') statusEl.classList.add('text-success');
    if (kind === 'err') statusEl.classList.add('text-error');
    if (kind === 'loading') statusEl.classList.add('opacity-80');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const accessKeyInput = form.querySelector('input[name="access_key"]');
    const key = accessKeyInput instanceof HTMLInputElement ? accessKeyInput.value.trim() : '';
    if (!key) {
      setStatus('err', 'Form is not configured.');
      return;
    }

    const fd = new FormData(form);
    const botcheck = String(fd.get('botcheck') || '');
    if (botcheck) {
      setStatus('err', 'Something went wrong.');
      return;
    }

    const payload = {
      access_key: key,
      name: String(fd.get('name') ?? '').trim(),
      organization: String(fd.get('organization') ?? '').trim(),
      email: String(fd.get('email') ?? '').trim(),
      message: String(fd.get('message') ?? '').trim(),
      subject: 'Contact form — byklika.com'
    };

    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
    setStatus('loading', 'Enviando…');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      const ok = data.success === true;
      const msg =
        data.message ||
        data.body?.message ||
        (ok ? 'Mensaje enviado. Te respondemos pronto.' : 'No pudimos enviar tu mensaje.');

      if (ok) {
        setStatus('ok', msg);
        form.reset();
        if (accessKeyInput instanceof HTMLInputElement) accessKeyInput.value = key;
      } else {
        setStatus('err', msg);
      }
    } catch {
      setStatus('err', 'Error de red. Probá de nuevo.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement && key) submitBtn.disabled = false;
    }
  });
</script>
