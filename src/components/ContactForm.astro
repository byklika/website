---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim();
const configured = Boolean(accessKey);

export interface Props {
  /** Visual tone for contrasting backgrounds. */
  tone?: 'dark' | 'light';
  /** Base used to generate stable, unique ids (avoid duplicates across page + sheet). */
  idBase?: string;
}

const { tone = 'dark', idBase = 'contact' } = Astro.props;

const isDark = tone === 'dark';
const formId = `${idBase}-form`;
const statusId = `${idBase}-status`;
const submitId = `${idBase}-submit`;
---

<div class="contact-form-component w-full">
  {
    !configured && (
      <div
        role="alert"
        class:list={[
          'mb-6 rounded-xl px-4 py-3 text-sm',
          isDark ? 'border border-white/15 bg-white/5 text-white/80' : 'border border-klika-sage/20 bg-klika-mist text-klika-dark/80'
        ]}
      >
        <span>
          El formulario no está configurado. Definí{' '}
          <code
            class:list={[
              'rounded px-1 text-xs',
              isDark ? 'bg-white/10 text-white' : 'bg-klika-cream text-klika-dark'
            ]}
          >
            PUBLIC_WEB3FORMS_ACCESS_KEY
          </code>{' '}
          en{' '}
          <code
            class:list={[
              'rounded px-1 text-xs',
              isDark ? 'bg-white/10 text-white' : 'bg-klika-cream text-klika-dark'
            ]}
          >
            .env
          </code>{' '}
          (ver{' '}
          <code
            class:list={[
              'rounded px-1 text-xs',
              isDark ? 'bg-white/10 text-white' : 'bg-klika-cream text-klika-dark'
            ]}
          >
            .env.example
          </code>
          ) y volvé a desplegar.
        </span>
      </div>
    )
  }

  <form id={formId} class="flex flex-col gap-5" novalidate>
    <input type="hidden" name="access_key" value={accessKey ?? ''} />
    <input type="hidden" name="project_stage" value="" />

    {/* Honeypot — leave empty; Web3Forms rejects spam when filled */}
    <label class="hidden" aria-hidden="true">
      <span>Company</span>
      <input type="text" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" />
    </label>

    <label class="flex flex-col gap-2">
      <span class:list={['text-[0.78rem] font-semibold tracking-[0.05em]', isDark ? 'text-white/50' : 'text-klika-sage/80']}>
        EMAIL
      </span>
      <input
        type="email"
        name="email"
        required
        maxlength="254"
        class:list={[
          'w-full rounded-[0.8rem] px-[1.1rem] py-[0.85rem] text-[0.9rem] outline-none transition',
          isDark
            ? 'border border-white/[0.14] bg-white/[0.06] text-white placeholder:text-white/25 focus:border-klika-coral focus:bg-white/[0.09]'
            : 'border border-klika-sage/25 bg-klika-cream text-klika-dark placeholder:text-klika-dark/35 focus:border-klika-coral'
        ]}
        autocomplete="email"
        disabled={!configured}
        placeholder="tu@correo.com"
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class:list={['text-[0.78rem] font-semibold tracking-[0.05em]', isDark ? 'text-white/50' : 'text-klika-sage/80']}>
        CONTANOS MÁS
      </span>
      <textarea
        name="message"
        maxlength="5000"
        rows={6}
        class:list={[
          'min-h-[120px] w-full resize-y rounded-[0.8rem] px-[1.1rem] py-[0.85rem] text-[0.9rem] outline-none transition',
          isDark
            ? 'border border-white/[0.14] bg-white/[0.06] text-white placeholder:text-white/25 focus:border-klika-coral focus:bg-white/[0.09]'
            : 'border border-klika-sage/25 bg-klika-cream text-klika-dark placeholder:text-klika-dark/35 focus:border-klika-coral'
        ]}
        disabled={!configured}
        placeholder="(Opcional) ¿En qué etapa de tu proyecto estás? ¿Qué necesitás?"
      ></textarea>
    </label>

    <div class="flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="inline-flex items-center gap-2 self-start rounded-pill bg-klika-coral px-[1.8rem] py-[0.75rem] text-[0.9rem] font-semibold text-klika-white transition hover:bg-klika-coralHover disabled:cursor-not-allowed disabled:opacity-60"
        disabled={!configured}
        id={submitId}
      >
        Enviar →
      </button>
      <span
        id={statusId}
        class:list={['text-sm', isDark ? 'text-white/80' : 'text-klika-dark/70']}
        role="status"
        aria-live="polite"
      ></span>
    </div>
  </form>
</div>

<script is:inline>
  const form = document.getElementById(${JSON.stringify(formId)});
  const statusEl = document.getElementById(${JSON.stringify(statusId)});
  const submitBtn = document.getElementById(${JSON.stringify(submitId)});
  const baseStatusClass = ${JSON.stringify(`text-sm ${isDark ? 'text-white/80' : 'text-klika-dark/70'}`)};

  function setStatus(kind, message) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.className = baseStatusClass;
    if (kind === 'ok') statusEl.classList.add('text-success');
    if (kind === 'err') statusEl.classList.add('text-error');
    if (kind === 'loading') statusEl.classList.add('opacity-80');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const accessKeyInput = form.querySelector('input[name="access_key"]');
    const key = accessKeyInput instanceof HTMLInputElement ? accessKeyInput.value.trim() : '';
    if (!key) {
      setStatus('err', 'Form is not configured.');
      return;
    }

    const emailEl = form.querySelector('input[name="email"]');
    if (emailEl instanceof HTMLInputElement) {
      emailEl.setCustomValidity('');
      const value = emailEl.value.trim();
      if (!value) {
        emailEl.setCustomValidity('Ingresá tu email.');
      } else if (emailEl.validity.typeMismatch) {
        emailEl.setCustomValidity('Ingresá un email válido.');
      }
      if (!emailEl.checkValidity()) {
        if (typeof emailEl.reportValidity === 'function') emailEl.reportValidity();
        emailEl.focus();
        setStatus('err', 'Por favor, revisá el email.');
        return;
      }
    }

    const fd = new FormData(form);
    const botcheck = String(fd.get('botcheck') || '');
    if (botcheck) {
      setStatus('err', 'Something went wrong.');
      return;
    }

    const payload = {
      access_key: key,
      email: String(fd.get('email') ?? '').trim(),
      message: String(fd.get('message') ?? '').trim(),
      subject: 'Contact form — byklika.com'
    };

    const projectStage = String(fd.get('project_stage') ?? '').trim();
    if (projectStage) {
      payload.project_stage = projectStage;
    }

    if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
    setStatus('loading', 'Enviando…');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      const ok = data.success === true;
      const msg =
        data.message ||
        data.body?.message ||
        (ok ? 'Mensaje enviado. Te respondemos pronto.' : 'No pudimos enviar tu mensaje.');

      if (ok) {
        setStatus('ok', msg);
        form.reset();
        if (accessKeyInput instanceof HTMLInputElement) accessKeyInput.value = key;
      } else {
        setStatus('err', msg);
      }
    } catch {
      setStatus('err', 'Error de red. Probá de nuevo.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement && key) submitBtn.disabled = false;
    }
  });
</script>
