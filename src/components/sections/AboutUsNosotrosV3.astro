---
import { cn } from '~/lib/helpers';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import type { Item } from './AboutUs.astro';

export interface Props {
  eyebrow: string;
  title: string;
  items: Item[];
  class?: string;
}

const { eyebrow, title, items, class: className } = Astro.props;

const RESPONSIVE_WIDTHS = [320, 480, 640, 800, 960] as const;
const buildSrcSet = (name: string, ext: 'avif' | 'webp' | 'jpg') =>
  RESPONSIVE_WIDTHS.map((width) => `/about-us/${name}-${width}w.${ext} ${width}w`).join(', ');

const imageByTitle: Record<
  string,
  {
    avifSrcSet: string;
    webpSrcSet: string;
    jpgSrcSet: string;
    jpgFallback: string;
    alt: string;
  }
> = {
  'Quiénes somos': {
    avifSrcSet: buildSrcSet('quienes-somos', 'avif'),
    webpSrcSet: buildSrcSet('quienes-somos', 'webp'),
    jpgSrcSet: buildSrcSet('quienes-somos', 'jpg'),
    jpgFallback: '/about-us/quienes-somos-640w.jpg',
    alt: 'Tres mujeres conversan y colaboran en una mesa de trabajo.'
  },
  'Nuestra experiencia': {
    avifSrcSet: buildSrcSet('nuestra-experiencia', 'avif'),
    webpSrcSet: buildSrcSet('nuestra-experiencia', 'webp'),
    jpgSrcSet: buildSrcSet('nuestra-experiencia', 'jpg'),
    jpgFallback: '/about-us/nuestra-experiencia-640w.jpg',
    alt: 'Equipo revisando contenido formativo con foco pedagógico.'
  },
  'Creación de Klika': {
    avifSrcSet: buildSrcSet('creacion-de-klika', 'avif'),
    webpSrcSet: buildSrcSet('creacion-de-klika', 'webp'),
    jpgSrcSet: buildSrcSet('creacion-de-klika', 'jpg'),
    jpgFallback: '/about-us/creacion-de-klika-640w.jpg',
    alt: 'Personas organizan ideas y definen el enfoque de un proyecto educativo.'
  },
  'Nuestro plan': {
    avifSrcSet: buildSrcSet('nuestro-plan', 'avif'),
    webpSrcSet: buildSrcSet('nuestro-plan', 'webp'),
    jpgSrcSet: buildSrcSet('nuestro-plan', 'jpg'),
    jpgFallback: '/about-us/nuestro-plan-640w.jpg',
    alt: 'Materiales, notas y laptop sobre una mesa durante planificación.'
  },
  'Nuestro compromiso': {
    avifSrcSet: buildSrcSet('nuestro-compromiso', 'avif'),
    webpSrcSet: buildSrcSet('nuestro-compromiso', 'webp'),
    jpgSrcSet: buildSrcSet('nuestro-compromiso', 'jpg'),
    jpgFallback: '/about-us/nuestro-compromiso-640w.jpg',
    alt: 'Equipo trabajando con atención en contenidos y decisiones de aprendizaje.'
  }
};
---

<section
  id="nosotras-v3"
  class={cn(
    'about-us-nosotras-v3-component',
    'section-gutter-x bg-klika-cream py-16 min-[901px]:py-24',
    className
  )}
  aria-label={`${eyebrow} — versión alternativa (v3)`}
>
  <div class="layout-container">
    <SectionHeading eyebrow={eyebrow} title={title} class="reveal" />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 2xl:gap-8">
      {
        items.map((it, idx) => {
          const image = imageByTitle[it.title];
          return (
            <article
              class:list={[
                'group relative isolate min-h-[340px] overflow-hidden rounded-[1.2rem] border-l-4 border-l-klika-coral shadow-card',
                'reveal',
                idx % 3 === 1 ? 'rd1' : idx % 3 === 2 ? 'rd2' : ''
              ]}
            >
              <picture class="pointer-events-none absolute inset-0">
                <source
                  srcset={image?.avifSrcSet ?? ''}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  type="image/avif"
                />
                <source
                  srcset={image?.webpSrcSet ?? ''}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  type="image/webp"
                />
                <img
                  src={image?.jpgFallback ?? ''}
                  srcset={image?.jpgSrcSet ?? ''}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  alt={image?.alt ?? ''}
                  class="nosotras-v3-image h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
              </picture>

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-klika-dark/65 via-transparent to-transparent"
                aria-hidden="true"
              />

              <div class="relative z-[1] flex min-h-[340px] flex-col justify-between">
                <div class="p-6">
                  <h3 class="inline-block max-w-[88%] rounded-md bg-klika-dark px-3.5 py-2 font-serif text-[1.35rem] font-normal leading-snug text-klika-white min-[901px]:text-[1.55rem]">
                    {it.title}
                  </h3>
                </div>

                <div class="bg-klika-dark/64 px-6 pb-6 pt-4 text-[0.95rem] leading-[1.6] text-klika-white/95">
                  <p class="nosotras-v3-description">{it.description}</p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .nosotras-v3-image {
    transform: scale(1);
    transition: transform 420ms ease;
  }

  .group:hover .nosotras-v3-image {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .nosotras-v3-image {
      transition: none;
    }

    .group:hover .nosotras-v3-image {
      transform: none;
    }
  }

  .nosotras-v3-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    text-wrap: pretty;
  }
</style>
