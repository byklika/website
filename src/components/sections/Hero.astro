---
import { cn } from '~/lib/helpers';
import Button from '~/components/ui/Button.astro';

export interface Props {
  eyebrow: string;
  titleHtml: string;
  subtitle: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  imageAlt: string;
  /** Used when no `slot="media"` content is provided */
  imageSrc?: string;
  class?: string;
}

const {
  eyebrow,
  titleHtml,
  subtitle,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  imageAlt,
  imageSrc,
  class: className
} = Astro.props;
---

<section
  id="inicio"
  class={cn(
    'hero-component',
    'relative flex min-h-screen flex-col overflow-hidden bg-klika-hero',
    className
  )}
>
  <div
    class="pointer-events-none absolute -top-[100px] -right-[80px] hidden lg:block lg:h-[clamp(280px,28vw,640px)] lg:w-[clamp(280px,28vw,640px)]"
    aria-hidden="true"
  >
    <div class="bg-klika-moss/[0.06] animate-morphBlob h-full w-full"></div>
  </div>

  <div
    class="section-gutter-x z-raised relative flex min-h-0 flex-1 flex-col justify-center pt-24 pb-12 lg:pt-28 lg:pb-16"
  >
    <div
      class="layout-container grid w-full grid-cols-1 items-center gap-12 text-center lg:grid-cols-2 lg:gap-12 lg:text-left xl:gap-16 2xl:gap-20"
    >
      <div>
        <p
          class="hero-eyebrow text-klika-moss mb-[1.2rem] inline-block text-[0.78rem] font-semibold tracking-[0.12em] uppercase"
        >
          {eyebrow}
        </p>
        <h1
          class="hero-title text-klika-dark animate-fadeUp mb-[1.4rem] font-serif text-[clamp(2.1rem,3.5vw+0.5rem,3.2rem)] leading-[1.12] xl:text-[clamp(2.55rem,3vw+0.5rem,3.75rem)] xl:leading-[1.1] 2xl:text-[clamp(2.85rem,2.4vw+1rem,4.25rem)]"
        >
          <Fragment set:html={titleHtml} />
        </h1>
        <p
          class="text-klika-ink animate-fadeUp mx-auto max-w-[480px] text-[1.02rem] leading-[1.7] [animation-delay:150ms] lg:mx-0 xl:max-w-[34rem] 2xl:max-w-prose"
        >
          {subtitle}
        </p>
        <div
          class="animate-fadeUp mt-9 flex flex-wrap justify-center gap-4 [animation-delay:300ms] lg:justify-start"
        >
          <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
        </div>
      </div>

      <div class="animate-fadeUp [animation-delay:200ms]">
        <div
          class="bg-klika-sand shadow-heroImage 2xl:shadow-heroImage2xl mx-auto aspect-[4/3] max-h-[min(72vh,52rem)] w-full max-w-[min(100%,42rem)] overflow-hidden rounded-[2rem] lg:mx-0 lg:max-w-none"
        >
          <slot name="media">
            {
              imageSrc ? (
                <img
                  src={imageSrc}
                  alt={imageAlt}
                  class="h-full w-full object-cover [object-position:center_top]"
                />
              ) : null
            }
          </slot>
        </div>
      </div>
    </div>
  </div>
</section>
