---
import SectionHeading from '../ui/SectionHeading.astro';
import FlipCard from '../cards/FlipCard.astro';

export interface Item {
  title: string;
  description: string;
}

export interface Props {
  eyebrow: string;
  title: string;
  items: Item[];
  class?: string;
}

const { eyebrow, title, items, class: className } = Astro.props;
---

<section
  id="nosotras"
  class={['bg-klika-white px-[1.5rem] py-16 min-[901px]:px-[3rem] min-[901px]:py-24', className].filter(Boolean).join(' ')}
>
  <div class="mx-auto max-w-6xl">
    <SectionHeading eyebrow={eyebrow} title={title} class="reveal" />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((it, idx) => (
        <FlipCard
          title={it.title}
          class={['reveal', idx % 3 === 1 ? 'rd1' : idx % 3 === 2 ? 'rd2' : ''].join(' ')}
        >
          <svg
            slot="hintIcon"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
          </svg>
          <svg slot="icon" width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="14" cy="14" r="9" />
            <path d="M14 8 L14 14 L18 16" />
          </svg>
          {it.description}
        </FlipCard>
      ))}
    </div>
  </div>
</section>

