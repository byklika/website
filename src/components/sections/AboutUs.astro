---
import { cn } from '~/lib/helpers';
import AboutUsFlipCardClockIcon from '~/icons/AboutUsFlipCardClockIcon.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import FlipCard from '~/components/cards/FlipCard.astro';

export interface Item {
  title: string;
  description: string;
}

export interface Props {
  eyebrow: string;
  title: string;
  items: Item[];
  class?: string;
}

const { eyebrow, title, items, class: className } = Astro.props;
---

<section
  id="nosotras"
  class={cn('about-us-component', 'section-gutter-x bg-klika-white py-16 min-[901px]:py-24', className)}
>
  <div class="layout-container">
    <SectionHeading eyebrow={eyebrow} title={title} class="reveal" />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 2xl:gap-8">
      {items.map((it, idx) => (
        <FlipCard
          title={it.title}
          class={['reveal', idx % 3 === 1 ? 'rd1' : idx % 3 === 2 ? 'rd2' : ''].join(' ')}
        >
          <AboutUsFlipCardClockIcon slot="icon" />
          {it.description}
        </FlipCard>
      ))}
    </div>
  </div>
</section>

