---
export interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;

// duplicate to create the seamless marquee loop
const doubled = [...items, ...items];
---

<div
  class="logo-marquee-component bg-klika-white border-klika-moss/15 overflow-hidden border-y py-[0.9rem]"
>
  <div class="mx-auto max-w-6xl px-[1.5rem] lg:px-[3rem]">
    <div class="animate-marquee flex gap-[4rem] whitespace-nowrap">
      <span class="text-klika-muted text-[0.75rem] font-semibold tracking-[0.1em] uppercase"
        >{label}</span
      >
      {
        doubled.map((t) => (
          <span class="border-klika-moss/20 text-klika-muted2 inline-flex h-7 items-center rounded-[4px] border px-[1.6rem] text-[0.72rem] font-semibold tracking-[0.08em]">
            {t}
          </span>
        ))
      }
    </div>
  </div>
</div>
