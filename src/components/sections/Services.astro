---
import { cn } from '~/lib/helpers';
import ServicesLatamGlobeBannerIcon from '~/icons/ServicesLatamGlobeBannerIcon.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Tabs, { type Tab } from '~/components/ui/Tabs.astro';
import ServiceCard from '~/components/cards/ServiceCard.astro';
import Button from '~/components/ui/Button.astro';
import Tag from '~/components/ui/Tag.astro';

export interface ServicePanel {
  id: 'tab1' | 'tab2' | 'tab3' | 'tab4';
  tabLabel: string;
  card: {
    label: string;
    title: string;
    tagline: string;
    includes: string[];
  };
}

export interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  tagline: string;
  panels: ServicePanel[];
  class?: string;
}

const { eyebrow, title, subtitle, tagline, panels, class: className } = Astro.props;
const tabs: Tab[] = panels.map((p) => ({ id: p.id, label: p.tabLabel }));
---

<section
  id="servicios"
  class={cn('services-component', 'section-gutter-x bg-klika-cream py-16 lg:py-24', className)}
>
  <div class="layout-container">
    <SectionHeading {eyebrow} {title} class="reveal">
      <p
        class="text-klika-sage mt-2 max-w-[640px] text-base leading-[1.7] 2xl:text-[1.0625rem] 2xl:leading-[1.65]"
      >
        {subtitle}
      </p>
    </SectionHeading>
    <p class="reveal rd1 text-klika-muted2 mt-3 mb-[2.8rem] max-w-3xl text-[0.84rem] italic">
      {tagline}
    </p>

    <div class="reveal rd2 mt-10">
      <Tabs {tabs} initialId={tabs[0]?.id}>
        {
          panels.map((p) => (
            <div data-panel={p.id} hidden={p.id !== tabs[0]?.id}>
              <ServiceCard
                label={p.card.label}
                title={p.card.title}
                tagline={p.card.tagline}
                includes={p.card.includes}
                ctaLabel="Quiero más información →"
                ctaSheetId="contact-sheet"
                projectStageValue={p.tabLabel}
              />
            </div>
          ))
        }
      </Tabs>
    </div>

    <div
      class="reveal rd1 border-klika-moss/20 bg-klika-cream mt-6 flex flex-wrap items-center justify-between gap-4 rounded-[1.2rem] border-[1.5px] px-[2.4rem] py-[2rem]"
    >
      <p class="text-klika-dark text-[0.95rem]">
        <strong class="font-serif font-bold">¿No encontraste lo que buscabas?</strong> ¡Escribinos y contanos
        sobre tu proyecto!
      </p>
      <Button
        type="button"
        variant="secondary"
        aria-haspopup="dialog"
        aria-controls="contact-sheet"
        data-sheet-open="contact-sheet"
      >
        Escribinos →
      </Button>
    </div>

    <div class="reveal border-klika-moss/15 mt-16 border-t pt-12">
      <p class="text-klika-coral text-xs font-semibold tracking-[0.12em] uppercase">
        Con quiénes trabajamos
      </p>
      <h3
        class="text-klika-dark mt-4 max-w-3xl font-serif text-[clamp(1.4rem,2vw+0.6rem,2rem)] leading-tight xl:text-[clamp(1.55rem,1.6vw+0.75rem,2.5rem)] 2xl:text-[clamp(1.7rem,1.2vw+1rem,2.85rem)]"
      >
        Con quienes deciden ir más allá y construir experiencias educativas memorables.
      </h3>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          [
            'Equipos de Recursos Humanos y L&D',
            'Instituciones públicas y ONGs',
            'Academias e Instituciones educativas',
            'Educadores particulares'
          ].map((t) => <Tag class="border-[1.5px] px-[1.4rem] py-[0.6rem] text-[0.88rem]">{t}</Tag>)
        }
      </div>

      <div
        class="bg-klika-moss mt-6 flex w-full min-w-0 flex-row gap-4 rounded-[1rem] px-5 py-5 max-[900px]:items-stretch lg:items-center lg:gap-5 lg:px-8 lg:py-6"
      >
        <div
          class="flex min-h-0 shrink-0 items-center justify-center overflow-hidden max-[900px]:[flex:0_0_clamp(1.625rem,9vmin,2.375rem)] max-[900px]:self-stretch lg:h-2.5 lg:w-2.5"
        >
          <ServicesLatamGlobeBannerIcon aria-hidden="true" />
        </div>
        <div class="flex min-h-0 min-w-0 flex-1 flex-col justify-center">
          <div class="text-klika-white text-[0.88rem] font-semibold tracking-[0.03em]">
            Para todo LATAM
          </div>
          <div class="mt-0.5 text-[0.76rem] text-white/65">
            Trabajamos de forma remota con equipos y organizaciones de toda la región.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
