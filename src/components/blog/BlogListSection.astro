---
/**
 * Paginated blog list (Daisy vertical rows). Left in place for `/blog/page/[n]/`.
 *
 * Follow-up: refactor to render `BlogArticleCard` via `blogEntryToCardProps()` from
 * `~/lib/blog-card` when the index swaps `blogPlaceholders` for live collection data.
 */
import type { CollectionEntry } from 'astro:content';
import { blogIndexIntro } from '~/data/blogPlaceholders';
import { blogPostHref } from '~/lib/blog-card';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  lastPage: number;
  url: { prev: string | undefined; next: string | undefined };
}

const { posts, currentPage, lastPage, url } = Astro.props;
---

<section class="space-y-8">
  <div class="prose max-w-none">
    <h1>{blogIndexIntro.title}</h1>
    <p>{blogIndexIntro.lead}</p>
  </div>
  <ul class="not-prose flex flex-col gap-4">
    {
      posts.map((post) => (
        <li>
          <a
            href={blogPostHref(post.id)}
            class="card bg-base-100 border-base-300 border shadow-sm transition-shadow hover:shadow-md"
          >
            <div class="card-body py-4">
              <h2 class="card-title text-lg">{post.data.title}</h2>
              {post.data.description && (
                <p class="text-base-content/80 text-sm">{post.data.description}</p>
              )}
              <time class="text-base-content/50 text-xs" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-AR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {posts.length === 0 && <p class="text-base-content/70">Todavía no hay artículos publicados.</p>}

  {
    lastPage > 1 && (
      <nav class="not-prose border-base-300 flex flex-wrap items-center justify-between gap-4 border-t pt-6">
        <p class="text-base-content/70 text-sm">
          Página {currentPage} de {lastPage}
        </p>
        <div class="flex flex-wrap gap-2">
          {url.prev ? (
            <a href={url.prev} class="btn btn-outline btn-sm">
              ← Más recientes
            </a>
          ) : (
            <span class="btn btn-outline btn-sm btn-disabled pointer-events-none">
              ← Más recientes
            </span>
          )}
          {url.next ? (
            <a href={url.next} class="btn btn-outline btn-sm">
              Más antiguos →
            </a>
          ) : (
            <span class="btn btn-outline btn-sm btn-disabled pointer-events-none">
              Más antiguos →
            </span>
          )}
        </div>
      </nav>
    )
  }
</section>
