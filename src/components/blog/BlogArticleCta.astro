---
import { blogArticleCtaDefaults } from '~/data/blogArticleContract';

interface Props {
  description?: string;
  buttonLabel?: string;
}

const { description, buttonLabel } = Astro.props;

const ctaDescription = description ?? blogArticleCtaDefaults.description;
const ctaButtonLabel = buttonLabel ?? blogArticleCtaDefaults.buttonLabel;
---

<section class="blog-article-cta reveal rd1 mb-16" aria-labelledby="blog-article-cta-title">
  <div class="relative">
    <h2 id="blog-article-cta-title" class="blog-article-cta__title">
      {blogArticleCtaDefaults.title}
    </h2>
    <p class="blog-article-cta__description">{ctaDescription}</p>
  </div>

  <button
    type="button"
    class="blog-article-cta__action"
    aria-haspopup="dialog"
    aria-controls="contact-sheet"
    data-sheet-open="contact-sheet"
  >
    {ctaButtonLabel}
  </button>
</section>
