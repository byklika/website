---
import BlogResponsiveImage from '~/components/blog/BlogResponsiveImage.astro';
import { blogHeroPlaceholderCaption } from '~/data/blogArticleContract';
import type { HeroImagePositionInput } from '~/lib/blog-hero-position';
import { resolveHeroImagePosition } from '~/lib/blog-hero-position';
import { cn } from '~/lib/helpers';

interface Props {
  title: string;
  /** Responsive bundle id when derivatives exist under `public/images/blog/`. */
  imageSlug?: string;
  /** Banner crop — see MDX `heroImagePosition`. */
  heroImagePosition?: HeroImagePositionInput;
}

const { title, imageSlug, heroImagePosition } = Astro.props;

const bannerLabel = `Imagen principal del artículo: ${title}`;
const crop = resolveHeroImagePosition(heroImagePosition);
const bannerStyle =
  crop &&
  ({
    ...(crop.mobile !== 'center' ? { '--hero-object-position-mobile': crop.mobile } : {}),
    ...(crop.desktop ? { '--hero-object-position-desktop': crop.desktop } : {})
  } as Record<string, string>);
---

{
  imageSlug ? (
    <div
      class={cn(
        'blog-article-banner border-klika-moss/10 relative overflow-hidden border-b',
        crop?.mobile && crop.mobile !== 'center' && 'blog-article-banner--mobile-position',
        crop?.desktop && 'blog-article-banner--desktop-position'
      )}
      style={bannerStyle}
    >
      <BlogResponsiveImage
        slug={imageSlug}
        alt={bannerLabel}
        sizes="banner"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  ) : (
    <div
      class="blog-article-banner border-klika-moss/10 bg-klika-cream relative flex items-center justify-center overflow-hidden border-b"
      role="img"
      aria-label={bannerLabel}
    >
      <span class="text-klika-muted2 inline-flex items-center gap-2.5 font-mono text-[0.68rem] tracking-[0.06em] uppercase opacity-85">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.6" />
          <path d="m21 15-5-5L5 21" />
        </svg>
        {blogHeroPlaceholderCaption}
      </span>
    </div>
  )
}
