---
import { blogBreadcrumbRoot } from '~/data/blogArticleContract';
import { formatBlogArticleDate, formatReadingTimeLabel } from '~/lib/blog-article';

interface Props {
  title: string;
  category: string;
  tags: string[];
  pubDate: Date;
  readingTimeMinutes: number;
}

const { title, category, tags, pubDate, readingTimeMinutes } = Astro.props;

const formattedDate = formatBlogArticleDate(pubDate);
const readingTimeLabel = formatReadingTimeLabel(readingTimeMinutes);
---

<header class="blog-article-header not-prose">
  <nav
    class="text-klika-muted2 mb-6 flex flex-wrap items-center gap-2 text-xs"
    aria-label="Migas de pan"
  >
    <a href={blogBreadcrumbRoot.href} class="hover:text-klika-coral transition-colors">
      {blogBreadcrumbRoot.label}
    </a>
    <span class="opacity-60" aria-hidden="true">›</span>
    <span class="text-klika-ink">{category}</span>
  </nav>

  <div
    class="mb-4 flex flex-wrap items-center gap-2.5 text-[0.68rem] font-bold tracking-[0.1em] uppercase"
  >
    <span class="text-klika-moss">{category}</span>
    <span class="bg-klika-muted2 h-[3px] w-[3px] shrink-0 rounded-full" aria-hidden="true"></span>
    <time class="text-klika-muted2 font-medium tracking-[0.04em]" datetime={pubDate.toISOString()}>
      {formattedDate}
    </time>
    <span class="bg-klika-muted2 h-[3px] w-[3px] shrink-0 rounded-full" aria-hidden="true"></span>
    <span class="text-klika-muted2 font-medium tracking-[0.04em]">{readingTimeLabel}</span>
  </div>

  <h1
    class="text-klika-dark mb-5 font-serif text-[30px] leading-[1.22] font-bold tracking-[-0.018em] text-balance"
  >
    {title}
  </h1>

  {
    tags.length > 0 && (
      <div class="mb-10 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="bg-klika-cream text-klika-moss rounded-[20px] border border-[#b5c4b3] px-[0.9rem] py-[0.34rem] text-[0.76rem] font-medium">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</header>
