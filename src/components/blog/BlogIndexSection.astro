---
import BlogArticleCard from '~/components/blog/BlogArticleCard.astro';
import { blogIndexCta, blogIndexIntro } from '~/data/blogPlaceholders';
import type { BlogIndexCardProps } from '~/lib/blog-index-cards';
import blogIndexDeferredCss from '~/styles/blog-index-deferred.css?url';

export interface Props {
  cards: BlogIndexCardProps[];
}

const { cards: indexCards } = Astro.props;
---

<section
  class="blog-index-section section-gutter-x pt-24 pb-16 lg:pt-28 lg:pb-24"
  aria-labelledby="blog-index-title"
>
  <div class="layout-container space-y-10 lg:space-y-16">
    <header class="blog-head max-w-[680px]">
      <h1 id="blog-index-title" class="animate-fadeUp">{blogIndexIntro.title}</h1>
      <p class="blog-head__lead animate-fadeUp [animation-delay:150ms]">{blogIndexIntro.lead}</p>
    </header>

    <div
      class="animate-fadeUp grid grid-cols-1 gap-6 [animation-delay:200ms] min-[561px]:grid-cols-2 min-[921px]:grid-cols-3"
    >
      {indexCards.map((entry, index) => <BlogArticleCard {...entry} priority={index === 0} />)}
    </div>

    <section class="blog-cta-banner reveal rd1" aria-labelledby="blog-cta-title">
      <div class="relative max-w-[560px]">
        <h2 id="blog-cta-title" class="blog-cta-banner__title">
          {blogIndexCta.title}
        </h2>
        <p class="blog-cta-banner__description">{blogIndexCta.description}</p>
      </div>

      <button
        type="button"
        class="blog-cta-banner__action"
        aria-haspopup="dialog"
        aria-controls="contact-sheet"
        data-sheet-open="contact-sheet"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 5L2 7"></path>
        </svg>
        {blogIndexCta.buttonLabel}
      </button>
    </section>
  </div>
</section>

<link rel="stylesheet" href={blogIndexDeferredCss} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={blogIndexDeferredCss} /></noscript>
