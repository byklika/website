---
import BlogResponsiveImage from '~/components/blog/BlogResponsiveImage.astro';
import { resolveBlogImageSlug } from '~/lib/blog-image';
import { cn } from '~/lib/helpers';
import type { BlogRelatedDisplayCard } from '~/lib/blog-article';
import { blogHeroPlaceholderCaption } from '~/data/blogArticleContract';

export interface Props extends BlogRelatedDisplayCard {
  class?: string;
}

const {
  slug,
  category,
  title,
  href,
  imageSlug: imageSlugProp,
  imageAlt = blogHeroPlaceholderCaption,
  class: className
} = Astro.props;

const imageSlug = resolveBlogImageSlug(imageSlugProp);

const cardSurface = cn(
  'blog-related-card',
  'group flex h-full flex-col overflow-hidden rounded-[14px] border border-klika-moss/[0.12] bg-white transition-[transform,box-shadow,border-color] duration-300 motion-reduce:transition-none',
  href
    ? 'hover:-translate-y-1 hover:border-klika-moss/20 hover:shadow-[0_16px_40px_rgba(30,42,26,0.12)]'
    : ''
);

const imageAreaClass = cn(
  'blog-related-card__img border-b border-klika-moss/10',
  imageSlug
    ? 'relative aspect-video overflow-hidden'
    : 'flex aspect-video items-center justify-center bg-klika-cream text-klika-muted2'
);
---

<article class={cn(cardSurface, className)} data-slug={slug}>
  <div class={imageAreaClass} aria-hidden={imageSlug ? undefined : 'true'}>
    {
      imageSlug ? (
        <BlogResponsiveImage slug={imageSlug} alt={imageAlt} sizes="related" loading="lazy" />
      ) : (
        <svg
          class="h-[30px] w-[30px] opacity-50"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.6" />
          <path d="m21 15-5-5L5 21" />
        </svg>
      )
    }
  </div>
  <div class="flex flex-1 flex-col px-[1.2rem] pt-[1.1rem] pb-[1.2rem]">
    <span class="text-klika-moss mb-[0.55rem] text-[0.64rem] font-bold tracking-[0.1em] uppercase">
      {category}
    </span>
    <h3
      class="text-klika-dark mb-[1.1rem] flex-1 font-serif text-[1.05rem] leading-[1.28] font-bold text-balance"
    >
      {
        href ? (
          <a href={href} class="blog-related-card__title-link">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <div class="mt-auto flex justify-end">
      {
        href ? (
          <a
            href={href}
            class="blog-related-card__read-more"
            aria-label={`Seguir leyendo: ${title}`}
          >
            Seguir leyendo
          </a>
        ) : (
          <span class="blog-related-card__read-more">Seguir leyendo</span>
        )
      }
    </div>
  </div>
</article>
