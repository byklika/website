---
import { blogAuthorDefaults } from '~/data/blogArticleContract';

interface Props {
  authorName: string;
  authorEmail: string;
}

const { authorName, authorEmail } = Astro.props;

const avatarInitial =
  authorName === blogAuthorDefaults.authorName
    ? blogAuthorDefaults.avatarInitial
    : (authorName.trim()[0] ?? blogAuthorDefaults.avatarInitial).toUpperCase();
---

<div class="blog-article-author not-prose mb-12 flex items-center gap-4">
  <div
    class="from-klika-moss to-klika-moss2 font-mitr text-klika-cream flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full bg-gradient-to-br text-[1.15rem] font-normal tracking-[-0.3px] lowercase"
    aria-hidden="true"
  >
    {avatarInitial}
  </div>
  <div class="flex flex-col gap-0.5">
    <span class="text-klika-dark text-[0.98rem] font-semibold">{authorName}</span>
    <a
      href={`mailto:${authorEmail}`}
      class="text-klika-muted2 hover:text-klika-coral text-[0.84rem] transition-colors"
    >
      {authorEmail}
    </a>
  </div>
</div>
