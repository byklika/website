---
import { cn } from '~/lib/helpers';
import Tag from '~/components/ui/Tag.astro';
import Button from '~/components/ui/Button.astro';

export interface Props {
  label: string;
  title: string;
  tagline?: string;
  description?: string;
  includes?: string[];
  /** Link destination when not using `ctaSheetId`. */
  ctaHref?: string;
  ctaLabel: string;
  /** When set, CTA opens the sheet instead of navigating. */
  ctaSheetId?: string;
  /** Optional: stage label to attach to CTA for project_stage. */
  projectStageValue?: string;
  class?: string;
}

const {
  label,
  title,
  tagline,
  description,
  includes = [],
  ctaHref,
  ctaLabel,
  ctaSheetId,
  projectStageValue,
  class: className
} = Astro.props;
---

<article
  class={cn(
    'service-card-component',
    'grid grid-cols-1 overflow-hidden rounded-[1.4rem] bg-klika-white shadow-card transition hover:shadow-cardHover 2xl:shadow-cardXl lg:grid-cols-[minmax(15rem,22vw)_1fr]',
    className
  )}
>
  <div class="bg-klika-dark flex flex-col justify-between px-[2rem] py-[2.4rem]">
    <div>
      <p class="text-klika-coral mb-3 text-[0.72rem] font-semibold tracking-[0.1em] uppercase">
        {label}
      </p>
      <h3 class="text-klika-white mb-2 font-serif text-[1.15rem] leading-snug">{title}</h3>
      {tagline && <p class="text-[0.84rem] leading-snug text-white/60">{tagline}</p>}
    </div>
    <slot name="leftBottom" />
  </div>

  <div class="bg-klika-white flex flex-col justify-between px-[2.2rem] py-[2.4rem]">
    <div class="max-w-prose space-y-4">
      {description && <p class="text-klika-ink text-[0.9rem] leading-relaxed">{description}</p>}

      {
        includes.length > 0 && (
          <div>
            <p class="text-klika-muted mb-2 text-[0.75rem] font-semibold tracking-[0.08em] uppercase">
              Incluye
            </p>
            <div class="flex flex-wrap gap-2">
              {includes.map((t) => (
                <Tag>{t}</Tag>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <div class="mt-6">
      {
        ctaSheetId ? (
          <button
            type="button"
            class="button-component rounded-pill focus-visible:ring-klika-coral border-klika-moss text-klika-moss hover:bg-klika-moss hover:text-klika-white inline-flex items-center gap-2 border-[1.5px] bg-transparent px-[1.4rem] py-[0.6rem] text-[0.84rem] font-semibold no-underline transition will-change-transform focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
            aria-haspopup="dialog"
            aria-controls={ctaSheetId}
            data-sheet-open={ctaSheetId}
            data-project-stage-source="service-card"
            data-project-stage-value={projectStageValue}
          >
            {ctaLabel}
          </button>
        ) : (
          <Button href={ctaHref!} variant="mossOutline">
            {ctaLabel}
          </Button>
        )
      }
    </div>
  </div>
</article>
