---
import { geoEntityContract } from '~/data/geoEntityContract';
import { cn } from '~/lib/helpers';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn(
    'geo-entity-summary not-prose grid gap-6 text-[0.95rem] leading-[1.65] text-klika-ink min-[601px]:grid-cols-2 min-[601px]:gap-8',
    className
  )}
>
  <div>
    <h3 class="text-klika-dark mb-2 font-serif text-lg font-bold">Quiénes somos</h3>
    <p>{geoEntityContract.whoWeAre}</p>
  </div>
  <div>
    <h3 class="text-klika-dark mb-2 font-serif text-lg font-bold">Qué hacemos</h3>
    <p>{geoEntityContract.whatWeDo}</p>
  </div>
</div>
