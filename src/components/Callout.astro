---
/**
 * Use in MDX: import Callout from '../components/Callout.astro'
 * <Callout variant="info" title="Note">Body text</Callout>
 */
interface Props {
  variant?: 'info' | 'warning' | 'error' | 'success';
  title?: string;
}

const { variant = 'info', title } = Astro.props;

const variantClass = {
  info: 'alert-info',
  warning: 'alert-warning',
  error: 'alert-error',
  success: 'alert-success'
} as const;
---

<div class:list={['alert', variantClass[variant], 'text-start shadow-sm']} role="note">
  <div class="flex w-full flex-col gap-1">
    {title && <span class="font-semibold">{title}</span>}
    <div class="text-sm [&_p]:my-1">
      <slot />
    </div>
  </div>
</div>
