---
import '~/styles/blog-index.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogIndexSection from '~/components/blog/BlogIndexSection.astro';
import { seoPageMeta } from '~/data/seoOnPageContract';
import { firstBlogIndexLcpImageSlug, getBlogIndexCards } from '~/lib/blog-index-cards';

const indexCards = await getBlogIndexCards();
const firstCardImageSlug = firstBlogIndexLcpImageSlug(indexCards);
---

<BaseLayout
  fullWidthMain
  blogIndexLcp
  {firstCardImageSlug}
  title={seoPageMeta.blog.title}
  description={seoPageMeta.blog.description}
>
  <BlogIndexSection cards={indexCards} />
</BaseLayout>
