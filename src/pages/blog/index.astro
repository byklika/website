---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
---

<BaseLayout title="Blog — Klika" description="Publicaciones, recursos y aprendizajes compartidos por el equipo de Klika.">
  <div class="page-copy space-y-10">
    <header class="max-w-none">
      <h1>Blog</h1>
      <p>
        Estamos preparando este espacio con artículos breves y recursos prácticos sobre diseño
        instruccional y experiencias de aprendizaje digital.
      </p>
    </header>

    <section class="max-w-none" aria-labelledby="blog-coming-soon">
      <h2 id="blog-coming-soon">Coming soon</h2>
      <p>
        El blog estará disponible pronto. Mientras tanto, podemos compartirte materiales y casos por
        contacto directo.
      </p>
    </section>

    <CTA
      title="¿Querés recibir novedades primero?"
      description="Escribinos y te avisamos cuando publiquemos los primeros artículos."
      openContactSheet
      label="Abrir contacto"
    />
  </div>
</BaseLayout>
