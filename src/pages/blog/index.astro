---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogListSection from '~/components/blog/BlogListSection.astro';
import { paginateBlogPosts } from '~/lib/blog-pagination';

const sorted = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const { data, currentPage, lastPage, url } = paginateBlogPosts(sorted, 1);
---

<BaseLayout title="Blog — Klika" description="News and articles from Klika.">
  <BlogListSection posts={data} currentPage={currentPage} lastPage={lastPage} url={url} />
</BaseLayout>
