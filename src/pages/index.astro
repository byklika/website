---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/Hero.astro';
import Methodology from '~/components/sections/Methodology.astro';
import Services from '~/components/sections/Services.astro';
import AboutUs from '~/components/sections/AboutUs.astro';
import type { Item as AboutUsItem } from '~/components/sections/AboutUs.astro';
import EmailSignupPopup from '~/components/EmailSignupPopup.astro';
import { seoPageMeta } from '~/data/seoOnPageContract';

/**
 * Hero raster: master lives under `src/assets/` (not publicly served).
 * Master: `src/assets/images/hero/home-hero-instructional-design-v2.png`
 * Optimized derivatives in `public/images/hero/` (AVIF → WebP → JPEG) — regenerate: `pnpm optimize:hero:v2`
 */
const heroImageBase = '/images/hero/home-hero-instructional-design-v2';
/**
 * Hero image column ≈ half of `.layout-container` (see `global.css` max-widths + `Hero` grid).
 * Slightly conservative caps vs. prior `sizes` to reduce over-fetch on common laptop widths.
 */
const heroImageSizes =
  '(min-width: 1920px) min(46rem, 42vw), (min-width: 1536px) min(40rem, 44vw), (min-width: 901px) min(36rem, 46vw), min(92vw, 42rem)';
const heroImageAlt =
  'Three professional women collaborating on an instructional design learning map around a wooden table in a bright, plant-filled office.';

/** Copy for `#nosotras` / `AboutUs` — archived variants in `docs/internal/archive/about-us-nosotras-variants/`. */
const nosotrasAboutItems: AboutUsItem[] = [
  {
    title: 'Quiénes somos',
    description:
      'Somos tres colegas que se volvieron amigas trabajando juntas en distintos proyectos. Lo que nos unió fue la pasión por la educación.'
  },
  {
    title: 'Nuestra experiencia',
    description:
      'Tenemos más de cinco años de experiencia en e‑learning: universidades, organizaciones públicas y privadas, edtech, freelance, empresas.'
  },
  {
    title: 'Creación de klika',
    titleHtml:
      'Creación de <span class="font-mitr font-normal lowercase tracking-[-0.3px]">klika</span>',
    description:
      'Creamos klika para capitalizar ese recorrido y trabajar como nos gusta: con profundidad pedagógica, cerca de cada proyecto.',
    descriptionHtml:
      'Creamos <span class="font-mitr font-normal lowercase tracking-[-0.3px]">klika</span> para capitalizar ese recorrido y trabajar como nos gusta: con profundidad pedagógica, cerca de cada proyecto.'
  },
  {
    title: 'Nuestro plan',
    description:
      'Trabajamos con una metodología que se adapta a las particularidades de cada proyecto y cliente.'
  },
  {
    title: 'Nuestro compromiso',
    description:
      'Nos comprometemos con que cada experiencia valga la pena, para quienes diseñan y para quienes aprenden.'
  }
];
---

<BaseLayout
  fullWidthMain
  heroLcp
  title={seoPageMeta.home.title}
  description={seoPageMeta.home.description}
>
  <Hero
    class="homepage-section homepage-section-hero"
    eyebrow="E‑Learning Studio"
    titleHtml={'Experiencias educativas<br/>que <em class="italic text-klika-coral">dejan huella</em>'}
    subtitle="Transformamos la manera de aprender. Diseñamos para que educadores y aprendices sientan que valió la pena."
    primaryHref="#servicios"
    primaryLabel="Conocé nuestros servicios →"
    secondaryHref="#metodologia"
    secondaryLabel="Metodología"
    imageAlt={heroImageAlt}
  >
    <picture slot="media">
      <source
        type="image/avif"
        srcset={`${heroImageBase}-480w.avif 480w, ${heroImageBase}-640w.avif 640w, ${heroImageBase}-960w.avif 960w, ${heroImageBase}-1280w.avif 1280w`}
        sizes={heroImageSizes}
      />
      <source
        type="image/webp"
        srcset={`${heroImageBase}-480w.webp 480w, ${heroImageBase}-640w.webp 640w, ${heroImageBase}-960w.webp 960w, ${heroImageBase}-1280w.webp 1280w`}
        sizes={heroImageSizes}
      />
      <img
        src={`${heroImageBase}-960w.jpg`}
        srcset={`${heroImageBase}-480w.jpg 480w, ${heroImageBase}-640w.jpg 640w, ${heroImageBase}-960w.jpg 960w, ${heroImageBase}-1280w.jpg 1280w`}
        alt={heroImageAlt}
        width={1452}
        height={1083}
        sizes={heroImageSizes}
        class="h-full w-full object-cover [object-position:center_top]"
        decoding="async"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
  </Hero>

  <Methodology
    class="homepage-section homepage-section-methodology"
    eyebrow="Nuestra metodología"
    title="Activar · Explorar · Conectar · Demostrar"
    intro="Cada experiencia que diseñamos tiene un hilo conductor: entender a quién aprende, generar las condiciones para que quiera aprender y asegurarnos de que algo concreto cambie al final."
    steps={[
      {
        title: 'Activar',
        description:
          'El aprendizaje empieza antes del primer contenido. Generamos una pregunta, una tensión, una razón para querer saber.'
      },
      {
        title: 'Explorar',
        description:
          'Con el “¿por qué?” instalado, cada persona explora a su ritmo. El contenido no tiene una sola puerta: video, texto, recursos interactivos, gamificación.'
      },
      {
        title: 'Conectar',
        description:
          'El encuentro sincrónico no es para transmitir lo que ya estaba disponible. Es para aplicar, debatir y construir con otros.'
      },
      {
        title: 'Demostrar',
        description:
          'El cierre no es un examen. Es la demostración de que algo cambió: un proyecto real, un entregable concreto, algo que la persona puede mostrar.'
      }
    ]}
  />

  <Services
    class="homepage-section homepage-section-services"
    eyebrow="Nuestros servicios"
    title="¿En qué momento de tu proyecto estás?"
    subtitle="Acompañamos cada etapa del proceso: desde ordenar las primeras ideas, hasta tener un programa completo listo para salir."
    tagline="Elegí lo que mejor describe tu situación y te contamos cómo podemos acompañarte."
    panels={[
      {
        id: 'tab1',
        tabLabel: 'No sé bien qué necesito',
        card: {
          label: 'Pensar y estructurar',
          title: 'La idea existe. Todavía no tiene forma.',
          tagline:
            'Antes de diseñar o producir cualquier cosa, hay que saber a dónde se va. Por acá se empieza.',
          includes: [
            'Consultoría',
            'Brief',
            'Diseño instruccional desde cero',
            'Rediseño de proceso formativo'
          ]
        }
      },
      {
        id: 'tab2',
        tabLabel: 'Sé qué enseñar, me falta la estructura',
        card: {
          label: 'Diseño del aprendizaje',
          title: 'Sabés qué querés enseñar. Nosotras diseñamos cómo.',
          tagline:
            'Qué enseñar, en qué orden, con qué lógica y cómo evaluar que el aprendizaje ocurrió.',
          includes: [
            'Recursos y materiales a partir del contenido brindado',
            'Creación de contenido con IA y validación posterior',
            'Migración de contenidos'
          ]
        }
      },
      {
        id: 'tab3',
        tabLabel: 'Ya tengo la estructura, me falta producirlo',
        card: {
          label: 'Producción de materiales',
          title: 'Ya tenés la estructura. Klika produce.',
          tagline:
            'Desde tu contenido, desde cero con IA y validación experta, o migrando lo que ya existe a un formato que funcione.',
          includes: [
            'Onboarding',
            'Habilidades técnicas',
            'Habilidades blandas',
            'Sesiones eventuales',
            'Pack Completo',
            'Pack con Piloto'
          ]
        }
      },
      {
        id: 'tab4',
        tabLabel: 'Quiero una solución completa',
        card: {
          label: 'Programas completos',
          title: 'No querés armar el rompecabezas solo.',
          tagline: 'Klika toma el proyecto de punta a punta. Diseño, producción y acompañamiento.',
          includes: ['Control de calidad de materiales', 'Rediseño de proceso formativo']
        }
      }
    ]}
  />

  <AboutUs
    class="homepage-section homepage-section-about"
    eyebrow="Nosotras"
    title="¿Por qué klika?"
    titleHtml='¿Por qué <span class="font-mitr font-normal lowercase tracking-[-0.3px]">klika</span>?'
    items={nosotrasAboutItems}
  />

  <EmailSignupPopup />
</BaseLayout>
