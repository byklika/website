---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import { seoPageMeta } from '~/data/seoOnPageContract';
---

<BaseLayout title={seoPageMeta.metodologia.title} description={seoPageMeta.metodologia.description}>
  <div class="page-copy space-y-10">
    <header class="max-w-none">
      <h1>Metodología</h1>
      <p>
        Trabajamos en ciclos cortos con entregables visibles: menos sorpresas, más alineación con tu
        equipo. Texto placeholder — PM entregará la versión definitiva.
      </p>
    </header>

    <section class="max-w-none" aria-labelledby="pasos">
      <h2 id="pasos">Pasos típicos</h2>
      <ol>
        <li>
          <strong>Diagnóstico</strong> — objetivos, audiencia, plataforma y criterios de éxito.
        </li>
        <li><strong>Diseño</strong> — blueprint, storyboard o guion según el formato.</li>
        <li><strong>Producción</strong> — assets, desarrollo en LMS o handoff a tu equipo.</li>
        <li>
          <strong>Cierre</strong> — checklist de calidad, accesibilidad básica y transferencia.
        </li>
      </ol>
    </section>

    <section class="max-w-none" aria-labelledby="cliente-aporta">
      <h2 id="cliente-aporta">Qué necesitamos de tu lado</h2>
      <p>
        Un referente con criterio de negocio, acceso a SME cuando haga falta, y decisiones de marca
        (tono, ejemplos permitidos, logos). Cuanto más claros los límites, más rápido iteramos.
      </p>
    </section>

    <section class="max-w-none" aria-labelledby="entregables">
      <h2 id="entregables">Entregables</h2>
      <p>
        Paquetes modulares: guiones, bancos de ítems, SCORM/HTML5, guías de facilitación o lo que
        acordemos en el alcance. Todo documentado para que tu equipo pueda mantenerlo.
      </p>
    </section>

    <CTA
      title="Coordinemos una llamada"
      description="Te contamos tiempos y opciones según tu etapa del proyecto."
      openContactSheet
      label="Abrir contacto"
    />
  </div>
</BaseLayout>
