# Copy to `.env.local` for local dev. In production, set these in your host (e.g. Vercel) — never commit real IDs if you treat them as sensitive.

# Optional override for Astro `site` / canonical URLs (defaults to https://byklika.com in astro.config.mjs)
# PUBLIC_SITE_URL=https://byklika.com

# --- Analytics (all optional; scripts load only when set) ---

# Google Analytics 4 — Measurement ID (format G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — project ID from the Clarity dashboard
PUBLIC_CLARITY_PROJECT_ID=

# GrowthBook — browser/client SDK key (safe to expose; wire experiments in the GrowthBook UI)
PUBLIC_GROWTHBOOK_CLIENT_KEY=

# --- Contact form (Web3Forms; domain-restrict in their dashboard) ---
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=

